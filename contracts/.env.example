# Arbitrum Stylus Contracts - Environment Configuration Example
# Copy this file to .env and populate with your credentials

# Network RPC Endpoints
# Arbitrum Sepolia (Testnet Chain ID: 421614)
ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"

# Arbitrum One (Mainnet Chain ID: 42161)
ARBITRUM_ONE_RPC="https://arb1.arbitrum.io/rpc"

# Arbitrum Orbit L3 Local Node (Chain ID: 918237)
ORBIT_L3_RPC="http://localhost:8547"

# Deployer Private Key (0x-prefixed hex string)
# Faucet for Arbitrum Sepolia: https://faucets.chain.link/arbitrum-sepolia or https://learnweb3.io/faucets/arbitrum_sepolia/
DEPLOYER_PRIVATE_KEY=""

# Active Deployed Stylus Contract Address on Arbitrum Sepolia
STYLUS_CONTRACT_ADDRESS="0xEE48074c6Db89E15d7DE7C6eF538a6799872A1b9"

# Arbiscan API Key (optional, for contract verification on arbiscan.io or sepolia.arbiscan.io)
ARBISCAN_API_KEY=""

