# Frontend Environment Configuration Example
# Copy to .env or set in your production hosting environment (Vercel / Cloudflare Pages)

# Deployed Stylus Contract Address on Arbitrum Sepolia
VITE_STYLUS_CONTRACT_ADDRESS="0xEE48074c6Db89E15d7DE7C6eF538a6799872A1b9"

# Arbitrum Sepolia RPC URL
VITE_ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"

# Network Chain ID (Arbitrum Sepolia = 421614, Arbitrum One = 42161)
VITE_CHAIN_ID="421614"

# Block Explorer URL
VITE_ARBISCAN_EXPLORER_URL="https://sepolia.arbiscan.io"
